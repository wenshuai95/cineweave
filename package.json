{
  "name": "ai-video-workstation",
  "version": "1.23.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader native",
    "build": "vite build --configLoader native",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:server": "node tests/run-server-tests.mjs",
    "test:win32": "node tests/run-win32-branch-test.mjs",
    "package:mac": "npm run build && node desktop/package-mac.mjs",
    "package:dmg": "npm run package:mac && node desktop/make-dmg.mjs",
    "package:win": "npm run build && node desktop/prepare-windows.mjs && electron-builder --config electron-builder.windows.json --win nsis --x64"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.7.0",
    "electron-builder": "26.15.3",
    "fake-indexeddb": "^6.2.5",
    "vite": "6.4.4"
  },
  "description": "CineWeave · 造梦工坊：本地优先的 AI 视频创作工作台（经典版 v1.21.0）",
  "license": "AGPL-3.0-only",
  "author": "wenshuai",
  "repository": {
    "type": "git",
    "url": "https://github.com/wenshuai95/cineweave.git"
  },
  "homepage": "https://github.com/wenshuai95/cineweave#readme",
  "bugs": {
    "url": "https://github.com/wenshuai95/cineweave/issues"
  }
}
